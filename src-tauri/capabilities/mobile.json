{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Mobile capabilities: filesystem restricted to the app sandbox container",
  "windows": ["main"],
  "platforms": ["iOS", "android"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:webview:default",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    {
      "identifier": "fs:scope",
      "allow": ["$APPDATA/**", "$APPLOCALDATA/**", "$APPCACHE/**", "$APPCONFIG/**", "$TEMP/**"]
    },
    "dialog:default",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "shell:default",
    "shell:allow-open",
    "deep-link:default",
    "haptics:default",
    "system-volume:default"
  ]
}
